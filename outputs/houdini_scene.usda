#usda 1.0
(
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def "World"
{
    def Camera "Camera"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 28
        float horizontalAperture = 20.955
        float horizontalApertureOffset = 0
        token projection = "perspective"
        float verticalAperture = 11.7872
        float verticalApertureOffset = 0
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 8)
        float3 xformOp:translate:pivot = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
    }

    def Sphere "A"
    {
        custom string pbvfx:cacheName = ""
        custom token pbvfx:isf_type = "isf_sphere"
        custom bool pbvfx:stamp = 0
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (5, 0, 0)
        float3 xformOp:translate:pivot = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
    }

    def Xform "torus"
    {
        custom string pbvfx:cacheName = ""
        custom token pbvfx:isf_type = "isf_torus"
        custom float pbvfx:majorRadius = 1
        custom float pbvfx:minorRadius = 0.4
        custom float3 pbvfx:normal = (0, 1, 0)
        custom bool pbvfx:stamp = 0
        float3 xformOp:rotateXYZ = (45, 30.000002, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 1.7000000476837158, 0)
        float3 xformOp:translate:pivot = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
    }

    def Xform "PhysVFXField"
    {
        custom string pbvfx:cacheName = ""
        custom token pbvfx:field_type = "wisp"
        custom bool pbvfx:stamp = 0
        custom float pbvfx:wispClump = 1
        custom float pbvfx:wispDensity = 1
        custom float3 pbvfx:wispDisplacement = (1, 1, 1)
        custom int pbvfx:wispDots = 10000
        custom float pbvfx:wispMax = 1
        custom float pbvfx:wispMin = -1
        custom float pbvfx:wispNoise1Frequency = 1
        custom float pbvfx:wispNoise1FrequencyJump = 1
        custom float pbvfx:wispNoise1Octaves = 2
        custom float pbvfx:wispNoise1Roughness = 0.5
        custom float3 pbvfx:wispNoise1Translation = (0, 0, 0)
        custom float pbvfx:wispNoise2Frequency = 1
        custom float pbvfx:wispNoise2FrequencyJump = 1
        custom float pbvfx:wispNoise2Octaves = 2
        custom float pbvfx:wispNoise2Roughness = 0.5
        custom float3 pbvfx:wispNoise2Translation = (0, 0, 0)
        custom float pbvfx:wispPscale = 1
        custom int pbvfx:wispSeed = 1
    }

    def SphereLight "Light"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:exposure = 0
        float inputs:intensity = 1
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 7)
        float3 xformOp:translate:pivot = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
    }

    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        custom float pbvfx:colorVoxelSize = 0.025
        custom float pbvfx:densityVoxelSize = 0.025
        custom float pbvfx:kappa = 3
        custom float pbvfx:maxStep = 0.05
        custom float pbvfx:minStep = 0.01
        custom float pbvfx:shadowKappa = 3
        custom float pbvfx:shadowStep = 0.01
        custom float pbvfx:shadowVoxelSize = 0.025
        uniform float pixelAspectRatio = 1
        uniform int2 resolution = (960, 540)
    }
}

