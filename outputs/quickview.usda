    def Xform "volcano_pyrod"
    {
        custom float pbvfx:amplitude = 1
        custom point3f pbvfx:boundsMax = (25, 25, 25)
        custom point3f pbvfx:boundsMin = (-25, -25, -25)
        custom string pbvfx:cacheName = ""
        custom float pbvfx:frequency = 0.24
        custom float pbvfx:frequencyJump = 1.8
        custom rel pbvfx:inputs = </World/volcano_base>
        custom float3 pbvfx:noiseTranslation = (10, 0, 0)
        custom float pbvfx:octaves = 5
        custom token pbvfx:operation = "terrain_displace"
        custom float pbvfx:roughness = 0.5
        custom bool pbvfx:stamp = 0
        custom float pbvfx:stampVoxelSize = 0
        custom float pbvfx:terrainAmpNeg = 6
        custom float pbvfx:terrainAmpPos = 2
        custom float pbvfx:terrainGammaNeg = 0.8
        custom float pbvfx:terrainGammaPos = 1
        custom int pbvfx:terrainIterations = 1
        custom float pbvfx:terrainTransition = 0.3
        custom bool pbvfx:useStampBounds = 0
    }

