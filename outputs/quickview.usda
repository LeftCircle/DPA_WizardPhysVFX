        custom int pbvfx:iterations = 1
        custom float3 pbvfx:noiseTranslation = (0, 0, 0)
        custom float pbvfx:octaves = 3
        custom token pbvfx:operation = "pyro"
        custom float pbvfx:roughness = 0.5
        custom bool pbvfx:stamp = 0
        custom float pbvfx:stampVoxelSize = 0
        custom bool pbvfx:useStampBounds = 0
    }

    def Xform "PhysVFXOperation"
    {
        custom string pbvfx:cacheName = ""
        custom color3f pbvfx:color = (0.144, 0.168, 0.224)
        custom rel pbvfx:inputs = [
            </World/volcano_pyrod>,
            </World/top_cut_pyrod>,
        ]
        custom token pbvfx:operation = "cutout"
        custom bool pbvfx:stamp = 1
        custom point3f pbvfx:stampBoundsMax = (12, 10, -3)
        custom point3f pbvfx:stampBoundsMin = (-4, -2, -19)
        custom float pbvfx:stampVoxelSize = 0.25
        custom bool pbvfx:useStampBounds = 1

        def BasisCurves "__physvfx_stamp_bounds"
        {
            int[] curveVertexCounts = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
            float3[] extent = [(-4.08, -2.08, -19.08), (12.08, 10.08, -2.92)]
            custom bool pbvfx:preview = 1
            point3f[] points = [(-4, -2, -19), (12, -2, -19), (-4, 10, -19), (12, 10, -19), (-4, -2, -3), (12, -2, -3), (-4, 10, -3), (12, 10, -3), (-4, -2, -19), (-4, 10, -19), (12, -2, -19), (12, 10, -19), (-4, -2, -3), (-4, 10, -3), (12, -2, -3), (12, 10, -3), (-4, -2, -19), (-4, -2, -3), (12, -2, -19), (12, -2, -3), (-4, 10, -19), (-4, 10, -3), (12, 10, -19), (12, 10, -3)]
            color3f[] primvars:displayColor = [(1, 0, 0)] (
                interpolation = "constant"
            )
            uniform token type = "linear"
            token visibility = "inherited"
            float[] widths = [0.08] (
                interpolation = "constant"
            )
        }
    }

    def RenderSettings "Settings"
    {
        rel camera = </World/TestCamera>
        custom float pbvfx:colorVoxelSize = 0.2
        custom float pbvfx:densityVoxelSize = 0.2
        custom float pbvfx:kappa = 3
        custom float pbvfx:maxStep = 0.02
        custom float pbvfx:minStep = 0.005
        custom float pbvfx:shadowKappa = 3
        custom float pbvfx:shadowStep = 0.05
        custom float pbvfx:shadowVoxelSize = 0.4
        uniform float pixelAspectRatio = 1
        uniform int2 resolution = (425, 540)
    }
}

