        double radius = 1
        double3 xformOp:translate = (-2.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "IntersectB"
    {
        custom token pbvfx:isf_type = "isf_sphere"
