        double radius = 1
        double3 xformOp:translate = (-1.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "CutA"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(0.1, 0.4, 1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (1.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "CutB"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(0.1, 0.4, 1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (2.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "AddA"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(1, 0.6, 0.1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (5.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "AddB"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(1, 0.6, 0.1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (6.5, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "SubtractA"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(0.6, 0.2, 1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (-6.5, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "SubtractB"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(0.6, 0.2, 1)] ( interpolation = "constant" )
        double radius = 1
        double3 xformOp:translate = (-5.5, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "PyroSource"
    {
        custom token pbvfx:isf_type = "isf_sphere"
        color3f[] primvars:displayColor = [(1, 0.35, 0.1)] ( interpolation = "constant" )
        double radius = 1.2
        double3 xformOp:translate = (-2, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "PlaneSource"
    {
        custom token pbvfx:field_type = "plane"
        custom float3 pbvfx:normal = (0, 1, 0)
        custom point3f pbvfx:boundsMin = (-10, -5.5, -2)
        custom point3f pbvfx:boundsMax = (10, -3.5, 2)
        custom color3f pbvfx:color = (0.25, 0.35, 0.6)
        double3 xformOp:translate = (0, -4.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "WispOne"
    {
        custom token pbvfx:field_type = "wisp"
        custom string pbvfx:cacheName = "showcase_wisp_one"
        custom int pbvfx:wispDots = 40000
