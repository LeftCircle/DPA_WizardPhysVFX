#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        float verticalAperture = 11.7871875
        float2 clippingRange = (0.1, 20)
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Sphere"
    {
        double radius = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "Light"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 2
        float inputs:exposure = 0
        custom float pbvfx:shadowKappa = 3
        double3 xformOp:translate = (2, 3, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (640, 360)
        custom float pbvfx:minStep = 0.02
        custom float pbvfx:maxStep = 0.05
        custom float pbvfx:kappa = 3
        custom float pbvfx:shadowStep = 0.05
        custom float pbvfx:densityVoxelSize = 0.05
        custom float pbvfx:colorVoxelSize = 0.05
        custom float pbvfx:shadowVoxelSize = 0.1
    }
}
